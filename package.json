{
  "name": "type-race",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun build src/client/index.html --outdir dist/client --splitting --minify --target browser --public-path /assets/",
    "dev": "bun --hot src/server/server.ts",
    "start": "bun run build && NODE_ENV=production bun src/server/server.ts",
    "share": "bun run build && NODE_ENV=production bun src/server/share.ts",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@neon/config": "^1.9.1",
    "@types/bun": "latest",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "three": "^0.186.1"
  }
}
